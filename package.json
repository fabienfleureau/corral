{
  "name": "corral",
  "version": "0.1.0",
  "description": "Feed work to your herdr workers; review and answer from one inbox.",
  "private": true,
  "type": "module",
  "bin": {
    "corral": "./server/cli.ts"
  },
  "scripts": {
    "serve": "node server/index.ts",
    "reload": "lsof -ti :${CORRAL_PORT:-4787} -sTCP:LISTEN | xargs kill 2>/dev/null; npm run serve",
    "dev": "node server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p web/tsconfig.json",
    "test": "node --test server/test/*.test.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
